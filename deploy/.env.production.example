# ════════════════════════════════════════════════════════════════════
#  BazarStore — variables de PRODUCTION
#  À copier sur le VPS : /srv/BazarStore/backend/.env   (chmod 600, jamais commité)
# ════════════════════════════════════════════════════════════════════

ENVIRONMENT=production
LOG_LEVEL=INFO
APP_TIMEZONE=Indian/Antananarivo
# Au moins 32 caractères aléatoires : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ─── Base PostgreSQL (conteneur « db » du compose) ──────────────────
POSTGRES_DB=bazarstore
POSTGRES_USER=bazarstore
# Mot de passe aléatoire ; le même dans DATABASE_URL ci-dessous.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://bazarstore:MOT_DE_PASSE_POSTGRES@db:5432/bazarstore

# ─── Domaines ───────────────────────────────────────────────────────
CORS_ORIGINS=https://bazarstore.rakotoarinosy.com
PUBLIC_FRONTEND_URL=https://bazarstore.rakotoarinosy.com
# Le site et l'API partagent l'origine (bazarstore.rakotoarinosy.com/api/v1) : lax suffit.
COOKIE_SAMESITE=lax

# ─── Premier administrateur (créé au 1er démarrage, puis RETIRER le mot de passe) ──
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrateur

# ─── Connexion Google (aussi transmis au site pour le bouton « Continuer avec Google ») ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── MinIO (VPS AndaoHiasa, port 9000 filtré sur l'IP de ce VPS) ────
MINIO_ENDPOINT=IP_DU_VPS_ANDAOHIASA:9000
MINIO_SECURE=false
# Clé dédiée à BazarStore, limitée au bucket (voir deploy/README.md)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bazarstore-products

# ─── Paiement en ligne (Stripe) ─────────────────────────────────────
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
# whsec_… de l'endpoint créé dans le dashboard Stripe :
# https://api.bazarstore.rakotoarinosy.com/api/v1/orders/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mga

# ─── Facturation ────────────────────────────────────────────────────
INVOICE_SELLER_NAME=BazarStore
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_CITY=Antananarivo, Madagascar
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_NIF=
INVOICE_SELLER_STAT=
INVOICE_SELLER_RCS=
INVOICE_VAT_RATE=20

# ─── Ports locaux (127.0.0.1) vers lesquels pointe le nginx de l'hôte ──
API_PORT=8070
WEB_PORT=4270
# PostgreSQL pour l'administration via tunnel SSH (127.0.0.1 du VPS uniquement)
DB_PORT=5434
UVICORN_WORKERS=2
