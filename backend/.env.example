# Copier ce fichier en `.env` : cp .env.example .env
# Les valeurs ci-dessous fonctionnent telles quelles en développement.

# development | production | test
# En production : logs JSON et documentation interactive (/docs, /redoc) masquée.
ENVIRONMENT=development

# SQLite en dev (fichier ./app.db, aucun setup).
# PostgreSQL en prod : postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# Origines autorisées par CORS, séparées par des virgules (frontend Angular).
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200,http://127.0.0.1:4300

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Signe les tokens d'accès (JWT). Obligatoire en prod : au moins 32 caractères aléatoires.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ─── Authentification ───────────────────────────────────────────────

# Durée de vie du token d'accès (minutes) et du refresh token (jours).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Verrouillage du compte après N échecs de connexion, pendant LOCKOUT_MINUTES minutes.
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Cookie du refresh token : lax | strict | none.
# lax si front et API partagent le même site (le proxy Angular appelle /api/v1 sur la même origine).
# none si les sites diffèrent (HTTPS obligatoire).
COOKIE_SAMESITE=lax

# Identifiant OAuth public du client Google Identity configuré dans le frontend.
# Laisser vide désactive l'endpoint de connexion Google.
GOOGLE_CLIENT_ID=
# Secret OAuth : active la connexion Google depuis Scalar (POST /api/v1/auth/google/token).
# Déclarer http://localhost:8000/docs dans les « URI de redirection autorisées » du client Google.
GOOGLE_CLIENT_SECRET=

# ─── Premier administrateur ─────────────────────────────────────────

# Créé au démarrage s'il n'existe aucun admin actif. Démarrer une fois,
# puis RETIRER le mot de passe de ce fichier.
BOOTSTRAP_ADMIN_EMAIL=admin@local.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrateur

# ─── IA : analyse des demandes (Gemini) ─────────────────────────────

# Clé à créer sur https://aistudio.google.com/apikey — ne jamais la commiter.
# Sans clé, le bouton « Analyser la demande » répond « IA non configurée » (503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Stockage MinIO des images produit ──────────────────────────────
# Endpoint hôte du conteneur existant (port publié 9010 -> MinIO 9000).
MINIO_ENDPOINT=127.0.0.1:9010
# Reprendre localement les identifiants du conteneur MinIO ; ne jamais les commiter.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bazarstore-products
MINIO_SECURE=false

# ─── Paiement MVola (Merchant Pay) ──────────────────────────────────
# Clés de l'application créée sur https://developer.mvola.mg (Consumer Key / Consumer Secret).
# Sans clés, « Payer la commande » répond « paiement MVola non configuré » (503).
MVOLA_BASE_URL=https://devapi.mvola.mg
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
# Sandbox : marchand 0343500004, client de test 0343500003. En production : votre numéro marchand.
MVOLA_MERCHANT_MSISDN=0343500004
MVOLA_PARTNER_NAME=BazarStore
# URL HTTPS publique (ex. tunnel ngrok) → PUT /api/v1/orders/payments/mvola/callback. Vide = polling.
MVOLA_CALLBACK_URL=

# ─── Paiement par carte (API Stripe externe) ────────────────────────
# POST /payments/checkout et GET /payments/ de l'API « E-commerce & Monitoring ».
CARD_PAYMENT_API_URL=https://ecommerce-api.rakotoarinosy.com
# Ariary pour 1 unité de la devise Stripe de cette API (1 EUR ≈ 5000 Ar).
CARD_PAYMENT_AR_PER_UNIT=5000

# ─── Facturation ────────────────────────────────────────────────────
# Mentions légales du vendeur affichées sur les factures PDF (laisser vide pour masquer une ligne).
INVOICE_SELLER_NAME=BazarStore
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_CITY=Antananarivo, Madagascar
INVOICE_SELLER_PHONE=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_NIF=
INVOICE_SELLER_STAT=
INVOICE_SELLER_RCS=
# Logo des factures (chemin d'un PNG/JPEG) ; vide = logo BazarStore fourni avec l'API.
INVOICE_LOGO_PATH=
# TVA en % (prix du catalogue TTC). 0 si le vendeur n'est pas assujetti à la TVA.
INVOICE_VAT_RATE=20
INVOICE_PAYMENT_TERMS=Paiement à réception de la facture.
